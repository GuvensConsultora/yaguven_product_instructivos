<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- Pestaña "Instructivos" en la ficha del producto -->
    <record id="product_template_form_view_instructivos" model="ir.ui.view">
        <field name="name">product.template.form.instructivos</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Instructivos" name="instructivos">
                    <field name="instructivo_ids">
                        <list editable="bottom" default_order="es_actual desc, sequence, lote desc">
                            <field name="sequence" widget="handle"/>
                            <field name="es_actual"/>
                            <field name="lote"/>
                            <field name="name"/>
                            <field name="product_id" optional="hide"
                                   options="{'no_create': True}"
                                   context="{'default_product_tmpl_id': id}"/>
                            <field name="archivo" filename="archivo_filename"/>
                            <field name="archivo_filename" column_invisible="1"/>
                            <field name="url"/>
                            <field name="active" column_invisible="1"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

    <!-- Vistas propias del modelo (gestión en lote) -->
    <record id="yaguven_product_instructivo_view_list" model="ir.ui.view">
        <field name="name">yaguven.product.instructivo.list</field>
        <field name="model">yaguven.product.instructivo</field>
        <field name="arch" type="xml">
            <list>
                <field name="product_tmpl_id"/>
                <field name="es_actual"/>
                <field name="lote"/>
                <field name="name"/>
                <field name="archivo" filename="archivo_filename"/>
                <field name="archivo_filename" column_invisible="1"/>
                <field name="url"/>
            </list>
        </field>
    </record>

    <record id="yaguven_product_instructivo_view_form" model="ir.ui.view">
        <field name="name">yaguven.product.instructivo.form</field>
        <field name="model">yaguven.product.instructivo</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="product_tmpl_id"/>
                            <field name="name"/>
                            <field name="lote"/>
                            <field name="es_actual"/>
                        </group>
                        <group>
                            <field name="archivo" filename="archivo_filename"/>
                            <field name="archivo_filename" invisible="1"/>
                            <field name="url" widget="url"/>
                            <field name="sequence"/>
                            <field name="active"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="yaguven_product_instructivo_view_search" model="ir.ui.view">
        <field name="name">yaguven.product.instructivo.search</field>
        <field name="model">yaguven.product.instructivo</field>
        <field name="arch" type="xml">
            <search>
                <field name="product_tmpl_id"/>
                <field name="name"/>
                <field name="lote"/>
                <filter name="actuales" string="Actuales" domain="[('es_actual','=',True)]"/>
                <filter name="historicos" string="Históricos" domain="[('es_actual','=',False)]"/>
                <group expand="0" string="Agrupar por">
                    <filter name="group_product" string="Producto"
                            context="{'group_by':'product_tmpl_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="yaguven_product_instructivo_action" model="ir.actions.act_window">
        <field name="name">Instructivos por producto</field>
        <field name="res_model">yaguven.product.instructivo</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="yaguven_product_instructivo_view_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Asociá el instructivo actual y los históricos por lote a cada producto.
            </p>
        </field>
    </record>

    <menuitem id="yaguven_product_instructivo_menu"
              name="Instructivos por producto"
              parent="sale.product_menu_catalog"
              action="yaguven_product_instructivo_action"
              sequence="50"/>

</odoo>
